# ─────────────────────────────────────────────
# stackisle — AEM local dev configuration
# Copy to .env (`make env` does it) and adjust.
# Read by scripts/lib/common.sh and docker compose.
# ─────────────────────────────────────────────

# ── Domains (space-separated) ────────────────
# Each gets: /etc/hosts entry, SAN in INSTALL_DIR/certs/<CERT_NAME>.crt, nginx server block
CUSTOM_DOMAINS="dev-local-www-brand.com dev-local-www-shop.brand.com dev-local-www-b2b.brand.com dev-local-www-new.brand.com"

# ── Paths ────────────────────────────────────
# Only these two are configurable; everything else is derived from them.
# Relative paths resolve from the project folder; absolute and ~ paths work.
# `make paths` shows the full layout; `make prereq` checks it is writable.
SDK_DIR="./sdk"       # The path of the SDK container: aem-sdk*.zip + unpacked SDK
INSTALL_DIR="./sdk"   # The path you want to install: author/ publish/ dispatcher/ certs/ nginx/

# ── Certificate ──────────────────────────────
# Generates ${CERTS_DIR}/${CERT_NAME}.crt and .key (mkcert if installed, else openssl)
CERT_NAME="server"

# ── AEM (local Java processes) ───────────────
AEM_AUTHOR_PORT=4502
AEM_PUBLISH_PORT=4503
AEM_AUTHOR_DEBUG_PORT=45045
AEM_PUBLISH_DEBUG_PORT=45046
AUTHOR_RUNMODE="author,local"
PUBLISH_RUNMODE="publish,local"
# Do not add -XX:MaxPermSize (removed in Java 8; the JVM refuses to start)
AEM_JVM_OPTS="-server -Xms1024m -Xmx4096m -Djava.awt.headless=true"

# Minimum Java major version. Must match what your AEM SDK demands —
# SDK 2026.x requires 21 ("Quickstart requires a Java Specification 21 VM").
JAVA_REQUIRED=21
# Java home for AEM. Leave blank to use `java` on PATH (must be >= JAVA_REQUIRED;
# `make prereq` checks). Set it when the default java is older:
#   linux: /usr/lib/jvm/java-21-openjdk-amd64 (or -arm64)
#   mac:   output of /usr/libexec/java_home -v 21
JAVA_HOME=""

# `make stop-aem` waits until AEM has shut down cleanly (SIGTERM → repository
# closes). 0 = wait as long as it takes (default). AEM is never force-killed;
# a value in seconds only limits how long stop waits (useful for CI).
AEM_STOP_TIMEOUT=0

# Local admin login used by scripts that call AEM's HTTP APIs (make wknd, make smoke)
AEM_ADMIN_USER="admin"
AEM_ADMIN_PASSWORD="admin"

# ── URLs & checks — scripts build every URL from these; nothing is hardcoded ──
# `make urls` prints the result; `make smoke` tests every hop.
# Host this machine uses to reach Author / Publish / Dispatcher
LOCAL_HOSTNAME="localhost"
# IP the CUSTOM_DOMAINS point to in the hosts file (also added to the cert SANs)
HOSTS_IP="127.0.0.1"
# Page used for end-to-end checks (make smoke, make wknd); change it for your own site
SMOKE_PATH="/content/wknd/us/en.html"
# Page that answers 200 once AEM is up (readiness checks)
AEM_LOGIN_PATH="/libs/granite/core/content/login.html"

# ── WKND sample site (optional: make wknd / make start-aem WKND=1) ──
WKND_REPO="adobe/aem-guides-wknd"          # GitHub repo with the releases
WKND_PACKAGE="aem-guides-wknd.all"         # package name (the AEMaaCS "all" package)
# Blank = latest release; or pin e.g. "3.2.0"
WKND_VERSION=""
# Where to install: "author publish" (default), "author" or "publish"
WKND_TARGETS="author publish"

# ── Dispatcher (container) ───────────────────
# Host port → container :80 → host.docker.internal:${AEM_PUBLISH_PORT}
DISPATCHER_PORT=9999
# trace1 | debug | info | warn | error
DISP_LOG_LEVEL="warn"
REWRITE_LOG_LEVEL="warn"
# Leave blank: auto-detected from the SDK by `make dispatcher`
DISPATCHER_IMAGE=""

# ── nginx SSL proxy (container) ──────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_IMAGE="nginx:1.27-alpine"

# ── Health check ─────────────────────────────
# Seconds `make` waits for AEM first boot (5-10 min typical)
HEALTH_TIMEOUT=900

